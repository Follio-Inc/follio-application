{
  "name": "follio-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:ci": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "live-qa": "playwright test --config=_admin-panel/modules/developer/live-qa/playwright.config.ts",
    "live-qa:install": "playwright install chromium",
    "live-qa:auth": "node scripts/live-qa-capture-auth.mjs",
    "pdf-worker": "npm start --prefix pdf-worker",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:run",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@clerk/nextjs": "^6.36.9",
    "@clerk/themes": "^2.4.57",
