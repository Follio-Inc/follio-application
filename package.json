    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.53.2",
    "react-resizable-panels": "^4.6.4",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
