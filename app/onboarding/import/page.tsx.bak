                        <CheckCircle2 className="h-3.5 w-3.5 text-white" />
                      </div>
                    </motion.div>
                  )}
                  {isUploadingGallery && (
                    <motion.div
                      initial={{ scale: 0, opacity: 0 }}
                      animate={{ scale: 1, opacity: 1 }}
                      exit={{ scale: 0, opacity: 0 }}
                      className="absolute right-3 top-3 z-10"
