generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @default(cuid())
  clerkId     String       @unique
  email       String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  mainPurpose MainPurpose?
  importJobs  ImportJob[]
  importLogs  ImportLog[]
  profile     Profile?
  shareTokens ShareToken[]

  @@index([clerkId])
  @@index([email])
}

model Profile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  handle                 String                 @unique
  status                 ProfileStatus          @default(DRAFT)
  firstName              String?
  firstNameSource        DataSource             @default(MANUAL)
  lastName               String?
  lastNameSource         DataSource             @default(MANUAL)
  headline               String?
  headlineSource         DataSource             @default(MANUAL)
  summary                String?
  summarySource          DataSource             @default(MANUAL)
  summarySuggestion      String?
  avatarUrl              String?
  avatarUrlSource        DataSource             @default(MANUAL)
  location               String?
  locationSource         DataSource             @default(MANUAL)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  publishedAt            DateTime?
  autoGeneratedDismissed Boolean                @default(false)
  awards                 Award[]
  certifications         Certification[]
  contactInfo            ContactInfo?
  dataSourceConnections  DataSourceConnection[]
  educations             Education[]
  githubProfile          GitHubProfile?
  links                  Link[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections               ProfileSection[]
  projects               Project[]
  rawImports             RawImportPayload[]
  skills                 Skill[]
  skillGroups            SkillGroup[]
  workExperiences        WorkExperience[]

  @@index([handle])
  @@index([status])
}

model ProfileSection {
  id            String            @id @default(cuid())
  profileId     String
  type          SectionType
  customName    String?
  title         String
  sortOrder     Int               @default(0)
  isVisible     Boolean           @default(true)
  customContent Json?
  contentType   CustomContentType @default(STRUCTURED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  profile       Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type, customName])
  @@index([profileId])
  @@index([sortOrder])
}

model ContactInfo {
  id               String     @id @default(cuid())
  profileId        String     @unique
  email            String?
  emailSource      DataSource @default(MANUAL)
  emailPublic      Boolean    @default(false)
  additionalEmails Json?      @default("[]")
  phone            String? // Legacy: full phone string for backward compat
  phoneCountryCode String? // New: country code (e.g., "+91")
  phoneNumber      String? // New: number without country code
  phoneSource      DataSource @default(MANUAL)
  phonePublic      Boolean    @default(false)
  additionalPhones Json?      @default("[]")
  website          String?
  websiteSource    DataSource @default(MANUAL)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  profile          Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Link {
  id        String     @id @default(cuid())
  profileId String
  type      LinkType
  url       String
  label     String?
  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model WorkExperience {
  id             String          @id @default(cuid())
  profileId      String
  company        String
  companyUrl     String?
  companyLogo    String?
  role           String
  location       String?
  locationType   LocationType?
  employmentType EmploymentType?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean         @default(false)
  description    String?
  bullets        String[]
  metrics        Json?
  tags           String[]
  source         DataSource      @default(MANUAL)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([startDate])
}

model Education {
  id              String     @id @default(cuid())
  profileId       String
  institution     String
  institutionUrl  String?
  institutionLogo String?
  degree          String?
  fieldOfStudy    String?
  location        String?
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean    @default(false)
  gpa             String?
  description     String?
  activities      String[]
  honors          String[]
  source          DataSource @default(MANUAL)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  profile         Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id         String      @id @default(cuid())
  profileId  String
  name       String
  level      SkillLevel?
  yearsOfExp Int?
  groupId    String?
  source     DataSource  @default(MANUAL)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  group      SkillGroup? @relation(fields: [groupId], references: [id])
  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@index([groupId])
}

model SkillGroup {
  id        String   @id @default(cuid())
  profileId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

model Project {
  id                String     @id @default(cuid())
  profileId         String
  title             String
  description       String?
  shortDesc         String?
  url               String?
  repoUrl           String?
  imageUrl          String?
  images            String[]
  techStack         String[]
  highlights        String[]
  // GitHub-specific fields
  githubStars       Int?
  githubForks       Int?
  githubLanguage    String?
  githubTopics      String[]
  githubOwner       String? // Owner/username for the repo
  githubRepo        String? // Repository name
  githubReadme      String? // README content (first ~500 chars)
  githubPinned      Boolean    @default(false) // Is this a pinned repo?
  githubLastPush    DateTime? // Last push date
  githubLicense     String? // License type (MIT, Apache, etc.)
  githubWatchers    Int? // Watchers count
  // Visibility & display controls
  isVisible         Boolean    @default(true) // User can hide completely
  showOnPortfolio   Boolean    @default(true) // Show on portfolio view
  showOnResume      Boolean    @default(true) // Show on resume view
  showStats         Boolean    @default(true) // Show GitHub stars/forks
  showReadme        Boolean    @default(false) // Show README preview on portfolio
  customDescription String? // User override for GitHub description
  // General fields
  startDate         DateTime?
  endDate           DateTime?
  isCurrent         Boolean    @default(false)
  featured          Boolean    @default(false)
  source            DataSource @default(MANUAL)
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  profile           Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([featured])
  @@index([githubPinned])
  @@index([isVisible])
}

model Award {
  id          String     @id @default(cuid())
  profileId   String
  title       String
  issuer      String?
  date        DateTime?
  description String?
  url         String?
  source      DataSource @default(MANUAL)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  profile     Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Certification {
  id             String     @id @default(cuid())
  profileId      String
  name           String
  issuer         String
  issuerLogo     String?
  credentialId   String?
  credentialUrl  String?
  issueDate      DateTime?
  expirationDate DateTime?
  source         DataSource @default(MANUAL)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  profile        Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model RawImportPayload {
  id          String       @id @default(cuid())
  profileId   String
  source      DataSource
  rawData     Json
  processedAt DateTime?
  status      ImportStatus @default(PENDING)
  errorMsg    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, source])
  @@index([profileId])
  @@index([source])
}

model ImportLog {
  id          String       @id @default(cuid())
  userId      String
  source      DataSource
  status      ImportStatus
  itemsFound  Int          @default(0)
  itemsMerged Int          @default(0)
  errorMsg    String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
}

model ShareToken {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique @default(cuid())
  expiresAt   DateTime?
  viewCount   Int       @default(0)
  maxViews    Int?
  allowedView String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model ImportJob {
  id          String       @id @default(cuid())
  userId      String
  source      DataSource
  status      ImportStatus @default(PENDING)
  inputType   String?
  inputData   Json?
  progress    Int          @default(0)
  currentStep String?
  itemsFound  Int          @default(0)
  itemsMerged Int          @default(0)
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([source])
}

model DataSourceConnection {
  id             String           @id @default(cuid())
  profileId      String
  source         DataSource
  status         ConnectionStatus @default(CONNECTED)
  externalId     String?
  accessToken    String?
  refreshToken   String?
  lastImportedAt DateTime?
  itemsImported  Int              @default(0)
  importError    String?
  lastSyncAt     DateTime?
  syncError      String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, source])
  @@index([profileId])
  @@index([source])
}

// GitHub-specific profile data (extended info not in main Profile)
model GitHubProfile {
  id                  String    @id @default(cuid())
  profileId           String    @unique
  username            String
  githubId            Int? // GitHub user ID
  avatarUrl           String?
  htmlUrl             String? // Profile URL
  bio                 String?
  company             String?
  blog                String?
  location            String?
  hireable            Boolean?
  publicRepos         Int       @default(0)
  publicGists         Int       @default(0)
  followers           Int       @default(0)
  following           Int       @default(0)
  accountCreatedAt    DateTime?
  // Computed statistics
  totalStars          Int       @default(0) // Sum of all repo stars
  totalForks          Int       @default(0) // Sum of all repo forks
  primaryLanguages    String[] // Top languages by usage
  languageStats       Json? // { "TypeScript": 45.5, "Python": 30.2, ... }
  contributionStats   Json? // Yearly contribution data if available
  // Organizations
  organizations       Json? // Array of { login, avatarUrl, url }
  // Display preferences (user-controlled)
  showOnPortfolio     Boolean   @default(true) // Show GitHub section on portfolio
  showStats           Boolean   @default(true) // Show follower/repo counts
  showOrganizations   Boolean   @default(true) // Show org badges
  showLanguageChart   Boolean   @default(true) // Show language breakdown
  showContributions   Boolean   @default(true) // Show contribution stats
  hiddenLanguages     String[] // Languages to exclude from display
  hiddenOrganizations String[] // Orgs to exclude from display
  // Sync metadata
  lastSyncAt          DateTime?
  syncStatus          String? // 'success' | 'error' | 'partial'
  syncError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([username])
}

enum MainPurpose {
  JOB_SEARCH
  PERSONAL_BRAND
  PROJECTS
  RESEARCH
  COMPANY
  OTHER
}

enum ProfileStatus {
  DRAFT
  PUBLIC
  PRIVATE
}

enum DataSource {
  MANUAL
  GITHUB
  RESUME
  LINKEDIN
  GENERATED
}

enum SectionType {
  BASIC_INFO
  CONTACT
  EXPERIENCE
  EDUCATION
  SKILLS
  PROJECTS
  LINKS
  AWARDS
  CERTIFICATIONS
  PUBLICATIONS
  VOLUNTEERING
  LANGUAGES
  INTERESTS
  CUSTOM
}

enum CustomContentType {
  STRUCTURED
  FREEFORM
}

enum LinkType {
  GITHUB
  LINKEDIN
  TWITTER
  PORTFOLIO
  BLOG
  DRIBBBLE
  BEHANCE
  YOUTUBE
  OTHER
}

enum LocationType {
  ONSITE
  REMOTE
  HYBRID
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}
