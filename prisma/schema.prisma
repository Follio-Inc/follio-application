generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  clerkId        String          @unique
  email          String          @unique
  lastSignInAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  mainPurpose    MainPurpose?
  importJobs     ImportJob[]
  importLogs     ImportLog[]
  importSessions ImportSession[]
  profile        Profile?        @relation("ActiveProfile")
  primaryProfile Profile?        @relation("PrimaryProfile")
  profiles       Profile[]       @relation("OwnedProfiles")
  shareTokens    ShareToken[]

  @@index([clerkId])
  @@index([email])
}

/// Completely separate admin table — admins are NOT regular users.
/// An admin has their own Clerk account and their own row here.
model Admin {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@index([email])
}

model Profile {
  id                     String                 @id @default(cuid())
  userId                 String
  activeForUserId        String?                @unique
  primaryForUserId       String?                @unique
  resumeTitle            String                 @default("Untitled Resume")
  isArchived             Boolean                @default(false)
  handle                 String                 @unique
  status                 ProfileStatus          @default(DRAFT)
  /// New resumes (blank/clone/upload) always start PRIVATE. At most one
  /// non-archived PUBLIC resume per user is enforced by a partial unique index
  /// (see migration `one_public_resume_per_user`).
  resumeVisibility       ContentVisibility      @default(PRIVATE)
  portfolioVisibility    ContentVisibility      @default(PUBLIC)
  linksVisibility        ContentVisibility      @default(PUBLIC)
  firstName              String?
  firstNameSource        DataSource             @default(MANUAL)
  middleName             String?
  middleNameSource       DataSource             @default(MANUAL)
  lastName               String?
  lastNameSource         DataSource             @default(MANUAL)
  headline               String?
  headlineSource         DataSource             @default(MANUAL)
  summary                String?
  summarySource          DataSource             @default(MANUAL)
  summarySuggestion      String?
  avatarUrl              String?
  avatarUrlSource        DataSource             @default(MANUAL)
  resumeShowPhoto        Boolean                @default(false)
  resumeDesign           Json?
  location               String?
  locationSource         DataSource             @default(MANUAL)
  unlistedKey            String?                @unique @default(cuid())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  publishedAt            DateTime?
  autoGeneratedDismissed Boolean                @default(false)
  awards                 Award[]
  blogPosts              BlogPost[]
  certifications         Certification[]
  contactInfo            ContactInfo?
  dataSourceConnections  DataSourceConnection[]
  educations             Education[]
  githubProfile          GitHubProfile?
  links                  Link[]
  photos                 ProfilePhoto[]
  user                   User                   @relation("OwnedProfiles", fields: [userId], references: [id], onDelete: Cascade)
  activeForUser          User?                  @relation("ActiveProfile", fields: [activeForUserId], references: [id], onDelete: SetNull)
  primaryForUser         User?                  @relation("PrimaryProfile", fields: [primaryForUserId], references: [id], onDelete: SetNull)
  sections               ProfileSection[]
  projects               Project[]
  rawImports             RawImportPayload[]
  skills                 Skill[]
  skillGroups            SkillGroup[]
  workExperiences        WorkExperience[]
  youtubeVideos          YouTubeVideo[]
  generatedPortfolios    GeneratedPortfolio[]
  agentRuns              AgentRun[]

  @@index([handle])
  @@index([status])
  @@index([userId])
}

model ProfileSection {
  id            String            @id @default(cuid())
  profileId     String
  type          SectionType
  customName    String?
  title         String
  sortOrder     Int               @default(0)
  isVisible     Boolean           @default(true)
  customContent Json?
  contentType   CustomContentType @default(STRUCTURED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  profile       Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type, customName])
  @@index([profileId])
  @@index([sortOrder])
}

model ContactInfo {
  id                String     @id @default(cuid())
  profileId         String     @unique
  email             String?
  emailSource       DataSource @default(MANUAL)
  emailPublic       Boolean    @default(false)
  additionalEmails  Json?      @default("[]")
  phone             String? // Legacy: full phone string for backward compat
  phoneCountryCode  String? // New: country code (e.g., "+91")
  phoneNumber       String? // New: number without country code
  phoneSource       DataSource @default(MANUAL)
  phonePublic       Boolean    @default(false)
  additionalPhones  Json?      @default("[]")
  locationPublic    Boolean    @default(true)
  website           String?
  websiteSource     DataSource @default(MANUAL)
  headerFieldsOrder Json? // Order of header fields: ["location","email","phone",linkId,...]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  profile           Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Link {
  id        String     @id @default(cuid())
  profileId String
  type      LinkType
  url       String
  label     String?
  isVisible Boolean    @default(true)
  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model WorkExperience {
  id             String          @id @default(cuid())
  profileId      String
  company        String
  companyUrl     String?
  companyLogo    String?
  role           String
  location       String?
  locationType   LocationType?
  employmentType EmploymentType?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean         @default(false)
  bullets        String[]
  bulletsHtml    String? /// Complete rich-text editor HTML for bullets (preserves alignment, bullet style, etc.)
  metrics        Json?
  isVisible      Boolean         @default(true)
  source         DataSource      @default(MANUAL)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([startDate])
}

model Education {
  id              String     @id @default(cuid())
  profileId       String
  institution     String
  institutionUrl  String?
  institutionLogo String?
  degree          String?
  fieldOfStudy    String?
  location        String?
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean    @default(false)
  gpa             String?
  description     String?
  activities      String[]
  honors          String[]
  isVisible       Boolean    @default(true)
  source          DataSource @default(MANUAL)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  profile         Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id         String      @id @default(cuid())
  profileId  String
  name       String
  level      SkillLevel?
  yearsOfExp Int?
  groupId    String?
  isVisible  Boolean     @default(true)
  source     DataSource  @default(MANUAL)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  group      SkillGroup? @relation(fields: [groupId], references: [id])
  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@index([groupId])
}

model SkillGroup {
  id         String   @id @default(cuid())
  profileId  String
  name       String
  sortOrder  Int      @default(0)
  /// Rich-text editor HTML for the skills column (preserves bold, bullets, alignment)
  skillsHtml String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  skills     Skill[]
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

model Project {
  id                String     @id @default(cuid())
  profileId         String
  title             String
  description       String?
  shortDesc         String?
  url               String?
  repoUrl           String?
  imageUrl          String?
  images            String[]
  techStack         String[]
  highlights        String[]
  // GitHub-specific fields
  githubStars       Int?
  githubForks       Int?
  githubLanguage    String?
  githubTopics      String[]
  githubOwner       String? // Owner/username for the repo
  githubRepo        String? // Repository name
  githubReadme      String? // README content (first ~500 chars)
  githubPinned      Boolean    @default(false) // Is this a pinned repo?
  githubLastPush    DateTime? // Last push date
  githubLicense     String? // License type (MIT, Apache, etc.)
  githubWatchers    Int? // Watchers count
  // Visibility & display controls
  isVisible         Boolean    @default(true) // User can hide completely
  showOnPortfolio   Boolean    @default(true) // Show on portfolio view
  showOnResume      Boolean    @default(true) // Show on resume view
  showStats         Boolean    @default(true) // Show GitHub stars/forks
  showReadme        Boolean    @default(false) // Show README preview on portfolio
  customDescription String? // User override for GitHub description
  // General fields
  startDate         DateTime?
  endDate           DateTime?
  isCurrent         Boolean    @default(false)
  featured          Boolean    @default(false)
  source            DataSource @default(MANUAL)
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  profile           Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([featured])
  @@index([githubPinned])
  @@index([isVisible])
}

model Award {
  id          String     @id @default(cuid())
  profileId   String
  title       String
  issuer      String?
  date        DateTime?
  description String?
  url         String?
  isVisible   Boolean    @default(true)
  source      DataSource @default(MANUAL)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  profile     Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Certification {
  id             String     @id @default(cuid())
  profileId      String
  name           String
  issuer         String
  issuerLogo     String?
  credentialId   String?
  credentialUrl  String?
  issueDate      DateTime?
  expirationDate DateTime?
  isVisible      Boolean    @default(true)
  source         DataSource @default(MANUAL)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  profile        Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model RawImportPayload {
  id          String       @id @default(cuid())
  profileId   String
  source      DataSource
  rawData     Json
  processedAt DateTime?
  status      ImportStatus @default(PENDING)
  errorMsg    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, source])
  @@index([profileId])
  @@index([source])
}

model ImportLog {
  id          String       @id @default(cuid())
  userId      String
  source      DataSource
  status      ImportStatus
  itemsFound  Int          @default(0)
  itemsMerged Int          @default(0)
  errorMsg    String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
}

model ShareToken {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique @default(cuid())
  expiresAt   DateTime?
  viewCount   Int       @default(0)
  maxViews    Int?
  allowedView String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model ImportJob {
  id          String       @id @default(cuid())
  userId      String
  source      DataSource
  status      ImportStatus @default(PENDING)
  inputType   String?
  inputData   Json?
  progress    Int          @default(0)
  currentStep String?
  itemsFound  Int          @default(0)
  itemsMerged Int          @default(0)
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([source])
}

/// Persists a resume import session so users can review proposed changes
/// at their own pace. Nothing mutates Builder data until the user explicitly
/// clicks "Apply selected changes".
model ImportSession {
  id            String              @id @default(cuid())
  userId        String
  source        DataSource
  status        ImportSessionStatus @default(PENDING_REVIEW)
  /// The full parsed + normalized data from the resume/source
  parsedData    Json
  /// The diff/preview computed against the current profile
  previewData   Json?
  /// Which items the user toggled on/off (persisted across visits)
  selections    Json?
  /// Any inline edits the user made before applying
  edits         Json?
  /// Human-readable filename or source label
  sourceLabel   String?
  /// Number of proposed items across all sections
  proposedCount Int                 @default(0)
  /// Number of items the user actually applied (filled after apply)
  appliedCount  Int?
  /// ISO timestamp when user applied (null until applied)
  appliedAt     DateTime?
  /// Expiry: auto-discard stale sessions after 30 days
  expiresAt     DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model DataSourceConnection {
  id             String           @id @default(cuid())
  profileId      String
  source         DataSource
  status         ConnectionStatus @default(CONNECTED)
  externalId     String?
  accessToken    String?
  refreshToken   String?
  lastImportedAt DateTime?
  itemsImported  Int              @default(0)
  importError    String?
  lastSyncAt     DateTime?
  syncError      String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, source])
  @@index([profileId])
  @@index([source])
}

// GitHub-specific profile data (extended info not in main Profile)
model BlogPost {
  id           String     @id @default(cuid())
  profileId    String
  title        String
  url          String
  slug         String?
  excerpt      String?
  content      String? // First ~500 chars for preview
  thumbnail    String?
  author       String?
  publishedAt  DateTime?
  updatedAt    DateTime   @updatedAt
  tags         String[]
  readTimeMin  Int? // Estimated read time in minutes
  claps        Int? // Medium-specific: clap count
  platform     String? // "medium", "substack", "devto", "hashnode", etc.
  platformIcon String?
  isVisible    Boolean    @default(true)
  isFeatured   Boolean    @default(false)
  source       DataSource @default(BLOG)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, url])
  @@index([profileId])
  @@index([publishedAt])
  @@index([isFeatured])
  @@index([isVisible])
}

model YouTubeVideo {
  id              String     @id @default(cuid())
  profileId       String
  videoId         String // YouTube video ID
  title           String
  description     String?
  url             String
  thumbnail       String?
  channelId       String?
  channelTitle    String?
  publishedAt     DateTime?
  duration        String? // ISO 8601 duration (e.g., "PT5M30S")
  viewCount       Int?       @default(0)
  likeCount       Int?       @default(0)
  commentCount    Int?       @default(0)
  tags            String[]
  isVisible       Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  showOnPortfolio Boolean    @default(true)
  source          DataSource @default(YOUTUBE)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  profile         Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, videoId])
  @@index([profileId])
  @@index([publishedAt])
  @@index([isFeatured])
  @@index([isVisible])
}

model ProfilePhoto {
  id          String        @id @default(cuid())
  profileId   String
  url         String
  originalUrl String? // Raw unmodified original image (before crop/adjust)
  adjustments Json? // Persisted editor state: {brightness, contrast, cropPosition, cropZoom, cropRotation, croppedAreaPixels}
  caption     String?
  category    PhotoCategory @default(GALLERY)
  source      DataSource    @default(MANUAL)
  sortOrder   Int           @default(0)
  isVisible   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profile     Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([category])
}

enum PhotoCategory {
  PROFILE // Profile photos (from uploads or OAuth sources)
  GALLERY // Additional photos for portfolio use
}

model GitHubProfile {
  id                  String    @id @default(cuid())
  profileId           String    @unique
  username            String
  githubId            Int? // GitHub user ID
  avatarUrl           String?
  htmlUrl             String? // Profile URL
  bio                 String?
  company             String?
  blog                String?
  location            String?
  hireable            Boolean?
  publicRepos         Int       @default(0)
  publicGists         Int       @default(0)
  followers           Int       @default(0)
  following           Int       @default(0)
  accountCreatedAt    DateTime?
  // Computed statistics
  totalStars          Int       @default(0) // Sum of all repo stars
  totalForks          Int       @default(0) // Sum of all repo forks
  primaryLanguages    String[] // Top languages by usage
  languageStats       Json? // { "TypeScript": 45.5, "Python": 30.2, ... }
  contributionStats   Json? // Yearly contribution data if available
  // Organizations
  organizations       Json? // Array of { login, avatarUrl, url }
  // Display preferences (user-controlled)
  showOnPortfolio     Boolean   @default(true) // Show GitHub section on portfolio
  showStats           Boolean   @default(true) // Show follower/repo counts
  showOrganizations   Boolean   @default(true) // Show org badges
  showLanguageChart   Boolean   @default(true) // Show language breakdown
  showContributions   Boolean   @default(true) // Show contribution stats
  hiddenLanguages     String[] // Languages to exclude from display
  hiddenOrganizations String[] // Orgs to exclude from display
  // Sync metadata
  lastSyncAt          DateTime?
  syncStatus          String? // 'success' | 'error' | 'partial'
  syncError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([username])
}

// ============================================================================
// PORTFOLIO GENERATION
// ============================================================================

/// Stores a generated portfolio plan and its pipeline outputs.
/// Each profile can have multiple versions; only one is published at a time.
model GeneratedPortfolio {
  id               String          @id @default(cuid())
  profileId        String
  version          Int             @default(1)
  status           PortfolioStatus @default(DRAFT)
  /// The complete PortfolioPlan JSON — the renderer contract
  plan             Json
  /// Raw collected profile data used as pipeline input
  collectedData    Json?
  /// Full pipeline debug info (all 6 stage outputs)
  pipelineOutput   Json?
  /// User's manual overrides on top of AI generation
  userOverrides    Json?
  /// Total generation time in milliseconds
  generationTimeMs Int?
  /// Total tokens consumed across all pipeline stages
  totalTokensUsed  Json?
  /// Pipeline version identifier (for tracking prompt/model changes)
  pipelineVersion  String?
  /// Whether this is the currently active/published portfolio
  isActive         Boolean         @default(false)
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, version])
  @@index([profileId])
  @@index([status])
  @@index([isActive])
}

/// Persisted agent run for cost, debugging, and observability across Follio agents.
model AgentRun {
  id                   String    @id @default(cuid())
  agentId              String
  version              String
  status               String
  stepMetas            Json      @default("[]")
  totalTokensUsed      Json      @default("{\"input\":0,\"output\":0}")
  startedAt            DateTime
  finishedAt           DateTime?
  error                String?
  requestId            String?
  userId               String?
  profileId            String?
  generatedPortfolioId String?
  meta                 Json?
  inputSummary         Json?
  outputSummary        Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  profile              Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([agentId, status])
  @@index([profileId])
  @@index([userId])
  @@index([startedAt])
}

enum PortfolioStatus {
  GENERATING
  DRAFT
  PUBLISHED
  FAILED
  ARCHIVED
}

enum MainPurpose {
  JOB_SEARCH
  PERSONAL_BRAND
  PROJECTS
  RESEARCH
  COMPANY
  OTHER
}

enum ProfileStatus {
  DRAFT
  PUBLIC
  PRIVATE
}

enum ContentVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum DataSource {
  MANUAL
  GITHUB
  RESUME
  LINKEDIN
  GOOGLE
  GENERATED
  MEDIUM
  YOUTUBE
  BLOG
}

enum SectionType {
  BASIC_INFO
  CONTACT
  PHOTOS
  SUMMARY
  EXPERIENCE
  EDUCATION
  SKILLS
  PROJECTS
  LINKS
  AWARDS
  CERTIFICATIONS
  PUBLICATIONS
  VOLUNTEERING
  LANGUAGES
  INTERESTS
  REFERENCES
  CUSTOM
}

enum CustomContentType {
  STRUCTURED
  FREEFORM
}

enum LinkType {
  GITHUB
  LINKEDIN
  TWITTER
  PORTFOLIO
  BLOG
  DRIBBBLE
  BEHANCE
  YOUTUBE
  MEDIUM
  SUBSTACK
  HASHNODE
  DEVTO
  OTHER
}

enum LocationType {
  ONSITE
  REMOTE
  HYBRID
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportSessionStatus {
  PENDING_REVIEW
  APPLIED
  DISCARDED
  EXPIRED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}
