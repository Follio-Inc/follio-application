// Prisma Schema for Follio - Digital Resume Platform
// This schema implements the canonical data model where content is stored
// as structured data and UI views are renderings of this model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// USER & AUTHENTICATION
// ===========================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // Clerk user ID for authentication
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Onboarding
  mainPurpose MainPurpose? // User's primary purpose for using the platform

  // Relations
  profile     Profile?
  importLogs  ImportLog[]
  shareTokens ShareToken[]
  importJobs  ImportJob[]

  @@index([clerkId])
  @@index([email])
}

// User's main purpose for using the platform
enum MainPurpose {
  JOB_SEARCH
  PERSONAL_BRAND
  PROJECTS
  RESEARCH
  COMPANY
  OTHER
}

// ===========================================
// PROFILE - Core canonical data container
// ===========================================

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public identity
  handle String @unique // URL-friendly identifier: /u/[handle]

  // Profile state
  status ProfileStatus @default(DRAFT)

  // Basic info with provenance
  firstName         String?
  firstNameSource   DataSource @default(MANUAL)
  lastName          String?
  lastNameSource    DataSource @default(MANUAL)
  headline          String? // Professional headline
  headlineSource    DataSource @default(MANUAL)
  summary           String?    @db.Text // About/bio section
  summarySource     DataSource @default(MANUAL)
  summarySuggestion String?    @db.Text // AI/import suggested summary (not yet accepted)

  // Profile photo
  avatarUrl       String?
  avatarUrlSource DataSource @default(MANUAL)

  // Location
  location       String?
  locationSource DataSource @default(MANUAL)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime? // When first made public

  // UI state
  autoGeneratedDismissed Boolean @default(false) // Whether user dismissed auto-generated banner

  // Relations
  contactInfo           ContactInfo?
  links                 Link[]
  workExperiences       WorkExperience[]
  educations            Education[]
  skills                Skill[]
  skillGroups           SkillGroup[]
  projects              Project[]
  awards                Award[]
  certifications        Certification[]
  rawImports            RawImportPayload[]
  sections              ProfileSection[]
  dataSourceConnections DataSourceConnection[]

  @@index([handle])
  @@index([status])
}

// Profile visibility states
enum ProfileStatus {
  DRAFT // Not visible to anyone except owner
  PUBLIC // Visible to everyone at /u/[handle]
  PRIVATE // Only accessible via share token
}

// Track where data originated
enum DataSource {
  MANUAL // User entered manually
  GITHUB // Imported from GitHub
  RESUME // Extracted from resume upload
  LINKEDIN // Imported from LinkedIn
  GENERATED // AI-generated suggestion
}

// ===========================================
// PROFILE SECTIONS - Dynamic section management
// ===========================================

model ProfileSection {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Section type
  type       SectionType
  customName String? // For CUSTOM type - user-defined name

  // Display settings
  title     String // Displayed title (can be customized)
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  // For custom sections - store content as JSON
  // Structure: { items: [{ title, description, startDate, endDate, url, ... }] } for structured
  // Or: { content: "rich text content" } for freeform
  customContent Json?
  contentType   CustomContentType @default(STRUCTURED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, type, customName])
  @@index([profileId])
  @@index([sortOrder])
}

enum SectionType {
  BASIC_INFO
  EXPERIENCE
  EDUCATION
  SKILLS
  PROJECTS
  LINKS
  AWARDS
  CERTIFICATIONS
  PUBLICATIONS
  VOLUNTEERING
  LANGUAGES
  INTERESTS
  CUSTOM
}

enum CustomContentType {
  STRUCTURED // title, description, dates, etc.
  FREEFORM // rich text
}

// ===========================================
// CONTACT INFO
// ===========================================

model ContactInfo {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  email       String?
  emailSource DataSource @default(MANUAL)
  emailPublic Boolean    @default(false) // Whether to show on public profile

  phone       String?
  phoneSource DataSource @default(MANUAL)
  phonePublic Boolean    @default(false)

  website       String?
  websiteSource DataSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================
// LINKS (Social profiles, websites, etc.)
// ===========================================

model Link {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type      LinkType
  url       String
  label     String? // Custom display label
  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

enum LinkType {
  GITHUB
  LINKEDIN
  TWITTER
  PORTFOLIO
  BLOG
  DRIBBBLE
  BEHANCE
  YOUTUBE
  OTHER
}

// ===========================================
// WORK EXPERIENCE
// ===========================================

model WorkExperience {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company        String
  companyUrl     String?
  companyLogo    String?
  role           String
  location       String?
  locationType   LocationType?
  employmentType EmploymentType?

  startDate DateTime
  endDate   DateTime? // Null = current position
  isCurrent Boolean   @default(false)

  description String?  @db.Text
  bullets     String[] // Array of bullet points

  // Structured metrics for recruiter view
  metrics Json? // { revenue: "10M", teamSize: 5, etc. }

  // Skills/technologies used
  tags String[]

  // Provenance
  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([startDate])
}

enum LocationType {
  ONSITE
  REMOTE
  HYBRID
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

// ===========================================
// EDUCATION
// ===========================================

model Education {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  institution     String
  institutionUrl  String?
  institutionLogo String?
  degree          String? // e.g., "Bachelor of Science"
  fieldOfStudy    String? // e.g., "Computer Science"
  location        String?

  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  gpa         String?
  description String?  @db.Text
  activities  String[] // Clubs, organizations
  honors      String[] // Dean's list, etc.

  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ===========================================
// SKILLS
// ===========================================

model Skill {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name       String
  level      SkillLevel?
  yearsOfExp Int?

  // Optional grouping
  groupId String?
  group   SkillGroup? @relation(fields: [groupId], references: [id])

  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
  @@index([profileId])
  @@index([groupId])
}

model SkillGroup {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name      String // e.g., "Frontend", "Backend", "DevOps"
  sortOrder Int    @default(0)

  skills Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
  @@index([profileId])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ===========================================
// PROJECTS
// ===========================================

model Project {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  shortDesc   String? // One-liner for portfolio cards

  // Links
  url     String? // Live project URL
  repoUrl String? // Source code

  // Media
  imageUrl String? // Main project image
  images   String[] // Additional images

  // Technical details
  techStack  String[]
  highlights String[] // Key achievements/features

  // GitHub-specific metadata (if imported)
  githubStars    Int?
  githubForks    Int?
  githubLanguage String?
  githubTopics   String[]

  // Timeline
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  // Visibility
  featured Boolean @default(false) // Show prominently

  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([featured])
}

// ===========================================
// AWARDS & CERTIFICATIONS
// ===========================================

model Award {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title       String
  issuer      String? // Organization that gave the award
  date        DateTime?
  description String?   @db.Text
  url         String? // Link to award/announcement

  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model Certification {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name          String
  issuer        String // e.g., "AWS", "Google"
  issuerLogo    String?
  credentialId  String?
  credentialUrl String? // Verification link

  issueDate      DateTime?
  expirationDate DateTime?

  source    DataSource @default(MANUAL)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ===========================================
// IMPORT TRACKING
// ===========================================

// Store raw import payloads for debugging and re-processing
model RawImportPayload {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  source      DataSource
  rawData     Json // Original imported data
  processedAt DateTime? // When it was processed into canonical model
  status      ImportStatus @default(PENDING)
  errorMsg    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, source])
  @@index([profileId])
  @@index([source])
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Log import operations for audit trail
model ImportLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source      DataSource
  status      ImportStatus
  itemsFound  Int          @default(0)
  itemsMerged Int          @default(0)
  errorMsg    String?
  metadata    Json? // Additional context

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([source])
}

// ===========================================
// SHARING
// ===========================================

model ShareToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String    @unique @default(cuid())
  expiresAt DateTime?
  viewCount Int       @default(0)
  maxViews  Int? // Optional view limit

  // Optional restrictions
  allowedView String? // Restrict to specific view (resume/portfolio/etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([userId])
}

// ===========================================
// IMPORT JOBS - Track import progress
// ===========================================

model ImportJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source    DataSource
  status    ImportStatus @default(PENDING)
  inputType String? // Type of input: 'oauth', 'file', 'url', etc.
  inputData Json? // Additional input metadata

  // Progress tracking
  progress    Int     @default(0) // 0-100
  currentStep String? // Current step description

  // Results
  itemsFound  Int     @default(0)
  itemsMerged Int     @default(0)
  result      Json? // Normalized import result data
  error       String? // Error message if failed

  // Timing
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([source])
}

// ===========================================
// DATA SOURCE CONNECTIONS - Track connected sources
// ===========================================

model DataSourceConnection {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  source       DataSource
  status       ConnectionStatus @default(CONNECTED)
  externalId   String? // External identifier (e.g., GitHub username)
  accessToken  String? // OAuth access token (encrypted)
  refreshToken String? // OAuth refresh token (encrypted)

  // Import tracking
  lastImportedAt DateTime? // When data was last imported from this source
  itemsImported  Int       @default(0) // Number of items imported
  importError    String? // Last import error message

  // Metadata
  lastSyncAt DateTime?
  syncError  String?
  metadata   Json? // Additional connection metadata

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, source])
  @@index([profileId])
  @@index([source])
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}
