# Environment Variables for Follio
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE (Required)
# ===========================================
# PostgreSQL connection string
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/follio
# For production with Neon: Use your Neon connection strings (see below)
#
# IMPORTANT FOR NEON SERVERLESS:
# DATABASE_URL should use the POOLED connection string (with -pooler suffix)
# DIRECT_URL should use the UNPOOLED/DIRECT connection string (without -pooler)
#
# Example Neon URLs:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=15"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
#
# For local Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/follio"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/follio"

# ===========================================
# CLERK AUTHENTICATION (Required)
# ===========================================
# Get these from https://dashboard.clerk.com
# Create a new application and copy the keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"
CLERK_SECRET_KEY="sk_test_your_key_here"

# Clerk redirect URLs (customize based on your app routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ===========================================
# GITHUB OAUTH (Optional - for GitHub import)
# ===========================================
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set callback URL to: https://your-domain.com/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===========================================
# APPLICATION (Required)
# ===========================================
# Your application's base URL
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# SUBDOMAIN ROUTING (Optional)
# ===========================================
# Enable subdomain-based portfolio URLs: username.follio.me
# Set to "true" in production when DNS wildcards are configured
NEXT_PUBLIC_SUBDOMAIN_ENABLED="false"

# The root domain for subdomain routing (without protocol)
# e.g., "follio.me" → username.follio.me
NEXT_PUBLIC_ROOT_DOMAIN="follio.me"

# ===========================================
# AI SERVICES (Required for Resume Parsing)
# ===========================================
# Anthropic API Key - REQUIRED for AI-powered resume parsing
# Get your API key from: https://console.anthropic.com/settings/keys
# Used model: claude-haiku-4-20250414 (cost-effective, excellent for structured extraction)
# 
# For Vercel deployment: Add this to your Vercel Environment Variables
# https://vercel.com/docs/environment-variables
ANTHROPIC_API_KEY=""

# ===========================================
# OPTIONAL SERVICES
# ===========================================
# Redis URL (optional - for rate limiting, caching)
# REDIS_URL=""

# ===========================================
# YOUTUBE DATA API (Optional - for YouTube import)
# ===========================================
# Get a free API key from Google Cloud Console:
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "YouTube Data API v3"
# 3. Create an API key (Credentials → Create credentials → API key)
# 4. Restrict the key to "YouTube Data API v3" for security
# Free tier: 10,000 quota units/day (~100 channel imports)
YOUTUBE_API_KEY=""
